ninja_required_version = 1.3
cxx = c++
cncc = /usr/local/neuware/bin/cncc

cflags = -Wno-unused-result -Wsign-compare -DNDEBUG -g -fwrapv -O3 -Wall -march=nocona -mtune=haswell -ftree-vectorize -fPIC -fstack-protector-strong -fno-plt -O2 -pipe -fPIC -I/home/ict-test/teacher/code_chap7_new/exp_5_1_custom_pytorch_mlu_op/mlu_custom_ext/mlu/include -I/torch/venv3/pytorch/lib/python3.10/site-packages/torch/include -I/torch/venv3/pytorch/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -I/torch/venv3/pytorch/lib/python3.10/site-packages/torch/include/TH -I/torch/venv3/pytorch/lib/python3.10/site-packages/torch/include/THC -I/torch/venv3/pytorch/lib/python3.10/site-packages/torch_mlu/csrc -I/torch/venv3/pytorch/lib/python3.10/site-packages/torch_mlu/csrc/api/include/torch_mlu -I/usr/local/neuware/include -I/torch/venv3/pytorch/include -I/opt/py3.10/include/python3.10 -c
post_cflags = -O3 -std=c++17 -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=libmlu_custom_ext -D_GLIBCXX_USE_CXX11_ABI=0
bang_cflags = --bang-arch=compute_30 --no-neuware-version-check -fPIC --neuware-path=/usr/local/neuware -std=c++17
bang_post_cflags = -O3 -Wall -fPIC -std=c++17 -pthread -O3 -I/home/ict-test/teacher/code_chap7_new/exp_5_1_custom_pytorch_mlu_op/mlu_custom_ext/mlu/include -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=libmlu_custom_ext -D_GLIBCXX_USE_CXX11_ABI=0 --bang-arch=compute_30 --no-neuware-version-check
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule bang_compile
  command = $cncc -c $in -o $out $bang_cflags $bang_post_cflags



